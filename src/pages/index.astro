---
import { content } from '../lib/content';
import { getImage } from 'astro:assets';
import { resolveImage } from '../lib/images';

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Highlights from '../components/Highlights.astro';
import Story from '../components/Story.astro';
import Services from '../components/Services.astro';
import Projects from '../components/Projects.astro';
import Gallery from '../components/Gallery.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const heroImage = await getImage({
  src: resolveImage(content.hero.imagePrimary),
  widths: [560, 900],
  format: 'webp'
});
const socialImage = await getImage({
  src: resolveImage(content.site.image),
  width: 1200,
  format: 'jpeg'
});
const brandLogo = await getImage({
  src: resolveImage(content.site.logo),
  width: 512,
  format: 'png'
});
---
<Layout
  site={content.site}
  artist={content.artist}
  social={content.social}
  heroImageHref={heroImage.src}
  heroImageSrcset={heroImage.srcSet.attribute}
  socialImage={socialImage.src}
  brandLogo={brandLogo.src}
>
  <Header navigation={content.navigation} logo={content.site.logo} />
  <main id="main">
    <Hero hero={content.hero} artist={content.artist} heroImage={heroImage} />
    <Highlights highlights={content.highlights} />
    <Story story={content.story} artist={content.artist} />
    <Services services={content.services} />
    <Projects projects={content.projects} />
    <Gallery gallery={content.gallery} />
    <Contact contact={content.contact} artist={content.artist} social={content.social} />
  </main>
  <Footer artist={content.artist} navigation={content.navigation} social={content.social} footer={content.footer} legal={content.legal} />
</Layout>
