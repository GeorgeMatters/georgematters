---
import '../styles/global.css';
import { content } from '../lib/content';

const { site, artist, navigation } = content;
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Seite nicht gefunden | {artist.name}</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <main class="notfound">
      <div class="container notfound-inner">
        <p class="eyebrow">Fehler 404</p>
        <h1 class="section-title">Diese Seite gibt es nicht.</h1>
        <p class="section-copy">
          Der Link ist vermutlich veraltet. Auf der Startseite finden Sie Anlässe,
          Projekte und den direkten Kontakt zu {artist.name}.
        </p>
        <div class="notfound-actions">
          <a class="button button--primary" href={import.meta.env.BASE_URL}>Zur Startseite</a>
          <a class="button button--secondary" href={`${import.meta.env.BASE_URL}${navigation.cta.href.replace(/^#/, '#')}`}>
            {navigation.cta.text}
          </a>
        </div>
      </div>
    </main>

    <style>
      .notfound {
        display: grid;
        place-items: center;
        min-height: 100vh;
        padding: 3rem 0;
      }

      .notfound-inner {
        max-width: 42rem;
        text-align: left;
      }

      .notfound-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        margin-top: 2rem;
      }
    </style>
  </body>
</html>
