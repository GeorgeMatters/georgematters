---
import Icon from './Icon.astro';

import type { Highlights } from '../lib/content';

interface Props {
  highlights: Highlights;
}

const { highlights } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="highlights-grid">
      {highlights.items.map((item) => (
        <article class="highlight-card panel">
          <div class="highlight-icon">
            <Icon name={item.icon} />
          </div>
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .highlight-card {
    padding: 1.6rem;
    min-height: 100%;
  }

  .highlight-icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.9rem;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .highlight-icon :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .highlight-card h2 {
    margin: 1rem 0 0;
    font-size: 1.08rem;
    line-height: 1.35;
  }

  .highlight-card p {
    margin: 0.75rem 0 0;
    color: var(--muted);
    line-height: 1.72;
  }

  @media (max-width: 980px) {
    .highlights-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
