---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

import type { Story, Artist } from '../lib/content';

interface Props {
  story: Story;
  artist: Artist;
}

const { story, artist } = Astro.props;
---
<section class="section" id="profil">
  <div class="container story-shell">
    <figure class="story-image panel">
      <Image src={resolveImage(story.image)} alt={story.imageAlt} widths={[480, 800, 1100]} sizes="(max-width: 980px) 100vw, 45vw" loading="lazy" />
    </figure>

    <div class="story-copy">
      <div class="section-intro">
        <div class="eyebrow">{story.kicker}</div>
        <h2 class="section-title">{story.headline}</h2>
      </div>

      <div class="story-text">
        {story.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <blockquote class="story-quote">
        “{story.quote}”
      </blockquote>

      <div class="story-facts">
        {story.facts.map((fact) => (
          <div class="story-fact panel">
            <span>{fact.label}</span>
            <strong>{fact.value}</strong>
          </div>
        ))}
      </div>

      <div class="story-meta">
        <div class="story-meta-card panel">
          <h3>{story.genresLabel}</h3>
          <div class="chips">
            {artist.genres.map((genre) => (
              <span class="chip">{genre}</span>
            ))}
          </div>
        </div>

        <div class="story-meta-card panel">
          <h3>{story.countriesLabel}</h3>
          <div class="chips">
            {artist.countriesPlayed.map((country) => (
              <span class="chip">{country}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .story-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: 3rem;
    align-items: start;
  }

  .story-image {
    overflow: hidden;
  }

  .story-image img {
    width: 100%;
    height: 100%;
    min-height: 36rem;
    object-fit: cover;
    object-position: center center;
  }

  .story-quote {
    margin: 1.5rem 0 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--accent);
    color: var(--sand);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    font-weight: 600;
    line-height: 1.5;
  }

  .story-copy {
    padding-top: 0.4rem;
  }

  .story-text p {
    margin: 0;
    color: var(--muted);
    line-height: 1.84;
  }

  .story-text p + p {
    margin-top: 1rem;
  }

  .story-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .story-fact {
    padding: 1rem;
  }

  .story-fact span {
    display: block;
    color: var(--muted);
    font-size: 0.84rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .story-fact strong {
    display: block;
    margin-top: 0.5rem;
    font-size: 1.05rem;
  }

  .story-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .story-meta-card {
    padding: 1.1rem;
  }

  .story-meta h3 {
    margin: 0 0 0.8rem;
    font-size: 1rem;
  }

  @media (max-width: 980px) {
    .story-shell {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .story-facts {
      grid-template-columns: 1fr;
    }

    .story-meta {
      grid-template-columns: 1fr;
    }
  }
</style>
