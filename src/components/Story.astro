---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

import type { Story, Artist } from '../lib/content';

interface Props {
  story: Story;
  artist: Artist;
}

const { story, artist } = Astro.props;
---
<section class="section" id="profil">
  <div class="container story-shell">
    <figure class="story-image">
      <Image src={resolveImage(story.image)} alt={story.imageAlt} widths={[480, 800, 1100]} sizes="(max-width: 980px) 100vw, 45vw" loading="lazy" />
    </figure>

    <div class="story-copy">
      <div class="section-intro">
        <div class="eyebrow">{story.kicker}</div>
        <h2 class="section-title">{story.headline}</h2>
      </div>

      <div class="story-text">
        {story.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <blockquote class="story-quote">
        “{story.quote}”
      </blockquote>

      <dl class="story-facts">
        {story.facts.map((fact) => (
          <div class="story-fact">
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>

      <div class="story-meta">
        <div class="story-meta-group">
          <h3>{story.genresLabel}</h3>
          <div class="chips">
            {artist.genres.map((genre) => (
              <span class="chip">{genre}</span>
            ))}
          </div>
        </div>

        <div class="story-meta-group">
          <h3>{story.countriesLabel}</h3>
          <div class="chips">
            {artist.countriesPlayed.map((country) => (
              <span class="chip">{country}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .story-shell {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .story-image {
    margin: 0;
  }

  .story-image :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong);
  }

  .story-text {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.15rem;
    max-width: 62ch;
  }

  .story-text p {
    margin: 0;
    color: var(--muted);
    line-height: 1.8;
  }

  .story-quote {
    margin: 2rem 0 0;
    padding-left: 1.35rem;
    border-left: 2px solid var(--accent);
    max-width: 52ch;
    color: var(--sand);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    font-weight: 500;
    line-height: 1.55;
  }

  .story-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--line-strong);
  }

  .story-fact {
    padding: 1.2rem 1rem 0 0;
  }

  .story-fact dt {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .story-fact dd {
    margin: 0.55rem 0 0;
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .story-meta {
    display: grid;
    gap: 1.75rem;
    margin-top: 2.5rem;
  }

  .story-meta-group h3 {
    margin: 0 0 0.85rem;
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .story-shell {
      grid-template-columns: 1fr;
    }

    .story-image :global(img) {
      aspect-ratio: 3 / 2;
    }
  }

  @media (max-width: 560px) {
    .story-facts {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
