---
import type { GetImageResult } from 'astro';
import type { HeroContent, Artist } from '../lib/content';

interface Props {
  hero: HeroContent;
  heroImage: GetImageResult;
  artist: Artist;
}

const { hero, artist, heroImage } = Astro.props;
---
<section class="hero section">
  <div class="container hero-shell">
    <div class="hero-copy section-shell">
      <div class="hero-copy-shell">
        <div class="eyebrow">{hero.kicker}</div>
        <h1 class="section-title hero-title">{hero.headline}</h1>
        <p class="section-copy hero-text">{hero.subheadline}</p>

        <div class="hero-actions">
          <a class="button button--primary" href={hero.ctaPrimary.href}>{hero.ctaPrimary.text}</a>
          <a class="button button--secondary" href={hero.ctaSecondary.href}>{hero.ctaSecondary.text}</a>
        </div>

      </div>

      <div class="hero-points">
        {hero.bookingFormats.map((item) => (
          <div class="hero-point">{item}</div>
        ))}
      </div>

      <div class="hero-stats">
        {hero.stats.map((stat) => (
          <div class="hero-stat panel">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="hero-media">
      <figure class="hero-image panel">
        <img
          src={heroImage.src}
          srcset={heroImage.srcSet.attribute}
          sizes="(max-width: 980px) 100vw, 45vw"
          width={heroImage.attributes.width}
          height={heroImage.attributes.height}
          alt={hero.imagePrimaryAlt}
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="hero-summary panel">
        <p class="hero-summary-label">{artist.city}, {artist.country}</p>
        <h2>{hero.summaryHeadline}</h2>
        <div class="chips hero-badges">
          {hero.badges.map((badge) => (
            <span class="chip">{badge}</span>
          ))}
        </div>
        <p class="hero-summary-foot">{artist.availability}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 2rem;
  }

  .hero-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: 3rem;
    align-items: start;
  }

  .hero-copy {
    padding: 2rem;
  }

  .hero-title {
    max-width: 12ch;
  }

  .hero-text {
    max-width: 40rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .hero-points {
    display: grid;
    gap: 0.95rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .hero-point {
    position: relative;
    padding-left: 1rem;
    color: var(--muted);
    line-height: 1.65;
  }

  .hero-point::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72rem;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: var(--accent);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 1.6rem;
  }

  .hero-stat {
    padding: 1.15rem;
  }

  .hero-stat strong {
    display: block;
    color: var(--sand);
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1;
    margin-bottom: 0.45rem;
  }

  .hero-stat span {
    display: block;
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.5;
  }

  .hero-media {
    display: grid;
    gap: 1.15rem;
    align-content: start;
  }

  .hero-image {
    overflow: hidden;
    min-height: 100%;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center center;
  }

  .hero-summary {
    padding: 1.5rem;
  }

  .hero-summary-label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hero-summary h2 {
    margin: 0.9rem 0 0;
    font-size: clamp(1.4rem, 2vw, 2rem);
    line-height: 1.28;
    letter-spacing: -0.03em;
  }

  .hero-badges {
    margin-top: 1.2rem;
  }

  .hero-summary-foot {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  @media (max-width: 980px) {
    .hero-shell {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero-copy {
      padding: 1.35rem;
    }

    .hero-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
