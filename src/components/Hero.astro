---
import type { GetImageResult } from 'astro';
import type { HeroContent, Artist } from '../lib/content';

interface Props {
  hero: HeroContent;
  heroImage: GetImageResult;
  artist: Artist;
}

const { hero, artist, heroImage } = Astro.props;
---
<section class="hero">
  <div class="container hero-shell">
    <div class="hero-copy">
      <p class="eyebrow">{hero.kicker}</p>
      <h1 class="hero-title">{hero.headline}</h1>
      <p class="hero-lead">{hero.subheadline}</p>

      <div class="hero-actions">
        <a class="button button--primary" href={hero.ctaPrimary.href}>{hero.ctaPrimary.text}</a>
        <a class="button button--secondary" href={hero.ctaSecondary.href}>{hero.ctaSecondary.text}</a>
      </div>

      <ul class="hero-points">
        {hero.bookingFormats.map((item) => <li>{item}</li>)}
      </ul>

      <dl class="hero-stats">
        {hero.stats.map((stat) => (
          <div class="hero-stat">
            <dt>{stat.value}</dt>
            <dd>{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <figure class="hero-media">
      <img
        src={heroImage.src}
        srcset={heroImage.srcSet.attribute}
        sizes="(max-width: 980px) 100vw, 42vw"
        width={heroImage.attributes.width}
        height={heroImage.attributes.height}
        alt={hero.imagePrimaryAlt}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <h2>{hero.summaryHeadline}</h2>
        <p class="hero-meta">
          <span>{artist.city}, {artist.country}</span>
          <span aria-hidden="true">·</span>
          <span>{artist.availability}</span>
        </p>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: 3.5rem 0 6rem;
  }

  .hero-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.4vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 700;
    max-width: 15ch;
    text-wrap: balance;
  }

  .hero-lead {
    margin: 1.5rem 0 0;
    max-width: 46ch;
    font-size: 1.06rem;
    line-height: 1.75;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero-points {
    list-style: none;
    margin: 2.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    max-width: 46ch;
  }

  .hero-points li {
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.6;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--line-strong);
  }

  .hero-stat {
    padding: 1.35rem 1.25rem 0 0;
  }

  .hero-stat dt {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--sand);
    font-variant-numeric: tabular-nums;
  }

  .hero-stat dd {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.45;
    max-width: 14ch;
  }

  .hero-media {
    margin: 0;
    display: grid;
    gap: 0;
  }

  .hero-media img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 22%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong);
  }

  .hero-media figcaption {
    padding: 1.5rem 0 0;
  }

  .hero-media h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.24rem;
    font-weight: 600;
    line-height: 1.42;
    letter-spacing: -0.015em;
    color: var(--text);
    text-wrap: balance;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  @media (max-width: 980px) {
    .hero-shell {
      grid-template-columns: 1fr;
    }

    .hero-media {
      order: -1;
    }

    .hero-media img {
      aspect-ratio: 3 / 2;
    }
  }

  @media (max-width: 560px) {
    .hero-stats {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem 0;
    }
  }
</style>
