---
import Icon from './Icon.astro';

import type { Services } from '../lib/content';

interface Props {
  services: Services;
}

const { services } = Astro.props;
---
<section class="section" id="anlaesse">
  <div class="container">
    <div class="section-intro">
      <div class="eyebrow">{services.kicker}</div>
      <h2 class="section-title">{services.headline}</h2>
      <p class="section-copy">{services.subheadline}</p>
    </div>

    <div class="services-grid">
      {services.items.map((item, index) => (
        <article class="service-card panel">
          <div class="service-topline">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div class="service-icon">
              <Icon name={item.icon} />
            </div>
          </div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .service-card {
    padding: 1.6rem;
    min-height: 100%;
  }

  .service-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    width: min(100%, calc(50% - 0.625rem));
    justify-self: center;
  }

  .service-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .service-topline span {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.14em;
  }

  .service-icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.9rem;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .service-icon :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .service-card h3 {
    margin: 1.2rem 0 0;
    font-size: 1.15rem;
  }

  .service-card p {
    margin: 0.75rem 0 0;
    color: var(--muted);
    line-height: 1.72;
  }

  @media (max-width: 980px) {
    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-card:last-child:nth-child(odd) {
      grid-column: auto;
      width: auto;
      justify-self: stretch;
    }
  }
</style>
