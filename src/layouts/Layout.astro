---
import '../styles/global.css';

import type { Site, Artist, Social } from '../lib/content';

interface Props {
  site: Site;
  artist: Artist;
  social: Social;
  heroImageHref: string;
  heroImageSrcset: string;
  socialImage: string;
  brandLogo: string;
}

const { site, artist, social, heroImageHref, heroImageSrcset, socialImage, brandLogo } = Astro.props;
const abs = (path: string) => new URL(path, site.url).href;
const imageUrl = abs(socialImage);
const logoUrl = abs(brandLogo);
const sameAs = social.items.map((item) => item.href);

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Person', 'MusicGroup'],
      '@id': `${site.url}/#artist`,
      name: artist.name,
      jobTitle: 'Musiker',
      genre: artist.genres,
      url: site.url,
      description: site.description,
      image: imageUrl,
      logo: logoUrl,
      email: artist.email,
      telephone: artist.phone,
      address: {
        '@type': 'PostalAddress',
        addressLocality: artist.city,
        addressCountry: artist.countryCode
      },
      sameAs
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${site.url}/#business`,
      name: artist.name,
      image: imageUrl,
      logo: logoUrl,
      url: site.url,
      email: artist.email,
      telephone: artist.phone,
      priceRange: 'Auf Anfrage',
      areaServed: artist.country,
      address: {
        '@type': 'PostalAddress',
        addressLocality: artist.city,
        addressCountry: artist.countryCode
      },
      founder: { '@id': `${site.url}/#artist` },
      sameAs
    }
  ]
};

// Escape `<` so no content value can terminate the script element early.
const schemaJson = JSON.stringify(schemaGraph).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      The site loads nothing third-party, so the policy can be strict.
      GitHub Pages cannot set response headers, so this is delivered as a
      meta policy. frame-ancestors is header-only and is therefore omitted;
      clickjacking is mitigated by the absence of any authenticated surface.

      PRODUCTION ONLY. The dev server serves every stylesheet as an inline
      <style> tag and injects an inline HMR client, both of which this policy
      blocks — which renders the dev page completely unstyled. The script
      hashes are also only computed by the build integration, so the
      placeholder would still be literal here.
    -->
    {import.meta.env.PROD && (
      <meta
        http-equiv="Content-Security-Policy"
        content="default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; manifest-src 'self'"
      />
    )}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={site.url} />

    <link
      rel="preload"
      as="image"
      href={heroImageHref}
      imagesrcset={heroImageSrcset}
      imagesizes="(max-width: 980px) 100vw, 45vw"
      fetchpriority="high"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.url} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={site.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={schemaJson} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="apple-touch-icon" href={brandLogo} />
  </head>
  <body>
    <a class="skip-link" href="#main">{site.skipLink}</a>
    <slot />
  </body>
</html>
